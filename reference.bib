@inproceedings{gareyWorstcaseAnalysisMemory1972,
  title = {Worst-Case Analysis of Memory Allocation Algorithms},
  booktitle = {Proceedings of the Fourth Annual {{ACM}} Symposium on {{Theory}} of Computing  - {{STOC}} '72},
